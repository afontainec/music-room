# Matches the Postgres in docker-compose.yml
DATABASE_URL=postgres://music_room:music_room@localhost:5432/music_room

# Uploaded mp3s (the Railway volume mount in production) and the largest accepted upload in bytes
STORAGE_DIR=./data/uploads
MAX_UPLOAD_BYTES=20971520

# The shared staff account (login is disabled while ADMIN_PASSWORD is unset), the key that signs
# staff tokens (sessions end on restart when unset) and how long a token lasts (default 12 h)
ADMIN_USERNAME=staff
ADMIN_PASSWORD=change-me
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_TTL_SECONDS=43200
