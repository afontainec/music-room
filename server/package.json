{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/cli.ts up",
    "db:rollback": "tsx --env-file-if-exists=../.env src/db/cli.ts down"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "vitest": "^5.0.3"
  }
}
